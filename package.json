{
  "name": "virastack",
  "version": "1.1.1",
  "description": "Scaffolding CLI for Next.js and TanStack Start: ViraStack tools and AI rules in one command",
  "author": {
    "name": "Ömer Gülçiçek (ViraStack)",
    "email": "iletisim@omergulcicek.com",
    "url": "https://omergulcicek.com"
  },
  "license": "MIT",
  "homepage": "https://virastack.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virastack/start.git"
  },
  "bugs": {
    "url": "https://github.com/virastack/start/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "virastack": "./bin/virastack.js"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "templates-i18n",
    "!src/**/*.test.js"
  ],
  "scripts": {
    "start": "node ./bin/virastack.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "clean:templates": "find templates templates-i18n -type d \\( -name 'node_modules' -o -name '.next' -o -name 'dist' -o -name '.vinxi' -o -name '.output' -o -name '.turbo' \\) -prune -exec rm -rf '{}' + && find templates templates-i18n -name '.eslintcache' -type f -delete",
    "prepublishOnly": "npm run check && npm run clean:templates"
  },
  "keywords": [
    "virastack",
    "start",
    "cli",
    "create-virastack",
    "scaffolding",
    "boilerplate",
    "nextjs",
    "tanstack",
    "react",
    "typescript",
    "dx"
  ],
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "cross-spawn": "^7.0.6",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
